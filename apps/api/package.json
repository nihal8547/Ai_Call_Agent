{
  "name": "@platform/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS REST API and telephony webhooks",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --env-file-if-exists=../../.env --enable-source-maps dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.1",
    "@bull-board/fastify": "^9.10.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.4.0",
    "@nestjs/common": "~11.2.6",
    "@nestjs/core": "~11.2.6",
    "@nestjs/platform-fastify": "~11.2.6",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@platform/ai": "*",
    "@platform/core": "*",
    "@platform/crypto": "*",
    "@platform/db": "*",
    "@platform/rag": "*",
    "@platform/runtime": "*",
    "@platform/shared": "*",
    "@platform/storage": "*",
    "@platform/telephony": "*",
    "@platform/templates": "*",
    "@platform/tools": "*",
    "bullmq": "^5.81.5",
    "fastify": "5.12.5",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^10.0.11",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "~11.2.6",
    "@swc/core": "^1.13.0",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "pino-pretty": "^13.0.0",
    "smtp-server": "^3.19.13",
    "tsc-watch": "^7.1.0",
    "unplugin-swc": "^2.0.0"
  }

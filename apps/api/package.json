{
  "name": "@platform/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS REST API and telephony webhooks",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --env-file-if-exists=../../.env --enable-source-maps dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@nestjs/common": "~11.2.6",
    "@nestjs/core": "~11.2.6",
    "@nestjs/platform-fastify": "~11.2.6",
    "@platform/db": "workspace:*",
    "@platform/shared": "workspace:*",
    "fastify": "5.11.3",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5",
    "jose": "^6.2.12",
    "@platform/crypto": "workspace:*",
    "@platform/core": "workspace:*",
    "@platform/runtime": "workspace:*",
    "@platform/ai": "workspace:*",
    "@platform/telephony": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/testing": "~11.2.6",
    "@swc/core": "^1.13.0",
    "pino-pretty": "^13.0.0",
    "tsc-watch": "^7.1.0",
    "unplugin-swc": "^1.5.5",
    "@platform/templates": "workspace:*"
  }
}

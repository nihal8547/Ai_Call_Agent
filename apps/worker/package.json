{
  "name": "@platform/worker",
  "version": "0.0.0",
  "private": true,
  "description": "BullMQ background workers",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@platform/shared": "workspace:*",
    "bullmq": "^5.81.5",
    "ioredis": "^5.11.1",
    "pino": "^9.14.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsc-watch": "^7.1.0"
  }
}

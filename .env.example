# Copy to .env and adjust. Every variable is validated at startup (see apps/*/src/**/env.ts).

NODE_ENV=development
LOG_LEVEL=info

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Runtime connection: member of app_user, Row-Level Security applies
DATABASE_URL=postgresql://voice_app:voice_app@localhost:5432/voice
# Owner connection: migrations and seed only
DATABASE_MIGRATION_URL=postgresql://voice_owner:voice_owner@localhost:5432/voice
SHADOW_DATABASE_URL=postgresql://voice_owner:voice_owner@localhost:5432/voice_shadow
# Integration tests (owner URL; tests create their own app_user connection)
TEST_DATABASE_URL=postgresql://voice_owner:voice_owner@localhost:5432/voice_test

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:4000

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4

# ── Web ───────────────────────────────────────────────────────────────────────
API_INTERNAL_URL=http://localhost:4000

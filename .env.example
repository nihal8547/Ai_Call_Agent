# Copy to .env and adjust. Every variable is validated at startup (see apps/*/src/**/env.ts).

NODE_ENV=development
LOG_LEVEL=info

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Runtime connection: member of app_user, Row-Level Security applies
DATABASE_URL=postgresql://voice_app:voice_app@localhost:5432/voice
# Owner connection: migrations and seed only
DATABASE_MIGRATION_URL=postgresql://voice_owner:voice_owner@localhost:5432/voice
SHADOW_DATABASE_URL=postgresql://voice_owner:voice_owner@localhost:5432/voice_shadow
# Integration tests: owner URL (migrations/reset) + app URL (queries under RLS)
TEST_DATABASE_URL=postgresql://voice_owner:voice_owner@localhost:5432/voice_test
TEST_APP_DATABASE_URL=postgresql://voice_app:voice_app@localhost:5432/voice_test

# ── Secrets ───────────────────────────────────────────────────────────────────
# Master key that encrypts every tenant's data key (32 bytes, base64).
# DEVELOPMENT ONLY — generate a new one per environment:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
MASTER_ENCRYPTION_KEY=RvUvr/RbOWDo23frbMOhJaobV1fJ8gLWO9bB45Oin9c=

# HMAC key for session access tokens (≥ 32 chars). DEVELOPMENT ONLY — generate per environment.
JWT_SECRET=96czSu6byUnGCX3gU0vku_nA0FtCf7NdiV5UtMWtQ9i3JQbkHAUvr9k9nmdZQbs0

# ── Seed (pnpm db:seed) ───────────────────────────────────────────────────────
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=ChangeMe-Dev-Only-2026!

# ── Telephony (Twilio) ────────────────────────────────────────────────────────
# Auth token from the Twilio console; webhooks are rejected unless signed with it
TWILIO_AUTH_TOKEN=
# Country code for numbers spoken without one
DEFAULT_COUNTRY_CODE=91
# Optional: attach your real Twilio numbers to the demo agents when seeding
# SEED_NUMBER_REAL_ESTATE=+91XXXXXXXXXX
# SEED_NUMBER_CLINIC=+91XXXXXXXXXX

# ── AI providers ──────────────────────────────────────────────────────────────
# Without a key, calls run on deterministic understanding and wording (fully functional, less natural)
GEMINI_API_KEY=
# Document embeddings: auto (Gemini when GEMINI_API_KEY is set, else keyword search only) | gemini | hashing (local, offline) | none
# Changing the provider later? Reprocess documents so their embeddings match.
EMBEDDINGS_PROVIDER=auto

# ── Document storage ──────────────────────────────────────────────────────────
# local (development, single server) | s3 (S3, MinIO, R2 or any S3-compatible store)
STORAGE_DRIVER=local
# Relative paths resolve from the repository root
STORAGE_LOCAL_DIR=.data/storage
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Largest file the API accepts (plans can set lower limits)
MAX_UPLOAD_MB=50

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Job key prefix (the API and worker must match); give each environment sharing a Redis its own
QUEUE_PREFIX=bull

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=4000
# Proxies allowed to set X-Forwarded-For (the web app proxies /api from localhost in development)
TRUST_PROXY=loopback
CORS_ORIGINS=http://localhost:3000
# Public HTTPS URL of the API as Twilio sees it (e.g. your tunnel URL); must match exactly for signatures
PUBLIC_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
# Secure (HTTPS-only) cookies; defaults to true when NODE_ENV=production
# COOKIE_SECURE=false

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4

# ── Web ───────────────────────────────────────────────────────────────────────
API_INTERNAL_URL=http://localhost:4000

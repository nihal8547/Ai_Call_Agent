# Copy to .env and adjust. Every variable is validated at startup (see apps/*/src/**/env.ts).

NODE_ENV=development
LOG_LEVEL=info

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Runtime connection: member of app_user, Row-Level Security applies
DATABASE_URL=postgresql://voice_app:voice_app@localhost:5432/voice
# Owner connection: migrations and seed only
DATABASE_MIGRATION_URL=postgresql://voice_owner:voice_owner@localhost:5432/voice
SHADOW_DATABASE_URL=postgresql://voice_owner:voice_owner@localhost:5432/voice_shadow
# Integration tests: owner URL (migrations/reset) + app URL (queries under RLS)
TEST_DATABASE_URL=postgresql://voice_owner:voice_owner@localhost:5432/voice_test
TEST_APP_DATABASE_URL=postgresql://voice_app:voice_app@localhost:5432/voice_test

# ── Secrets ───────────────────────────────────────────────────────────────────
# Master key that encrypts every tenant's data key (32 bytes, base64).
# DEVELOPMENT ONLY — generate a new one per environment:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
MASTER_ENCRYPTION_KEY=RvUvr/RbOWDo23frbMOhJaobV1fJ8gLWO9bB45Oin9c=

# HMAC key for session access tokens (≥ 32 chars). DEVELOPMENT ONLY — generate per environment.
JWT_SECRET=96czSu6byUnGCX3gU0vku_nA0FtCf7NdiV5UtMWtQ9i3JQbkHAUvr9k9nmdZQbs0

# ── Seed (npm run db:seed) ───────────────────────────────────────────────────────
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=ChangeMe-Dev-Only-2026!

# ── Telephony (Twilio) ────────────────────────────────────────────────────────
# Auth token from the Twilio console; webhooks are rejected unless signed with it
TWILIO_AUTH_TOKEN=
# Country code for numbers spoken without one (each business's own country overrides it)
DEFAULT_COUNTRY_CODE=974
# Platform Twilio account: lets businesses buy numbers and creates SIP domains for SIP connections.
# Without it, numbers are added by hand and SIP connections wait for the operator ("Waiting for setup").
# Prefer an API key (Console → Account → API keys); the auth token above also works as the secret.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_API_KEY_SID=SK...
# TWILIO_API_KEY_SECRET=
# Streaming voice (Twilio ConversationRelay) for agents set to "Streaming" in their Voice settings.
# Twilio connects to wss://<PUBLIC_BASE_URL host>/telephony/twilio/relay (WebSockets must pass the proxy).
# "false" answers every call turn by turn. The rest: re-prompt after silence, speech pace, "one moment" delay.
# VOICE_STREAMING=true
# RELAY_SILENCE_MS=8000
# RELAY_SPEECH_CHAR_MS=70
# RELAY_FILLER_MS=3000
# Optional: attach your real Twilio numbers to the demo agents when seeding
# SEED_NUMBER_REAL_ESTATE=+974XXXXXXXX
# SEED_NUMBER_CLINIC=+974XXXXXXXX

# ── AI providers ──────────────────────────────────────────────────────────────
# Without a key, calls run on deterministic understanding and wording (fully functional, less natural)
GEMINI_API_KEY=
# Document embeddings: auto (Gemini when GEMINI_API_KEY is set, else keyword search only) | gemini | hashing (local, offline) | none
# Changing the provider later? Reprocess documents so their embeddings match.
EMBEDDINGS_PROVIDER=auto

# ── Document storage ──────────────────────────────────────────────────────────
# local (development, single server) | s3 (S3, MinIO, R2 or any S3-compatible store)
STORAGE_DRIVER=local
# Relative paths resolve from the repository root
STORAGE_LOCAL_DIR=.data/storage
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Largest file the API accepts (plans can set lower limits)
MAX_UPLOAD_MB=50

# ── Integrations ──────────────────────────────────────────────────────────────
# One-click "Continue with …" sign-in for integrations. Step-by-step setup: docs/OAUTH_SETUP.md
# "Connect with Google" for Calendar, Sheets and Gmail (OAuth web client; redirect URI: {WEB_BASE_URL}/api/v1/integrations/oauth/google/callback).
# Without it, businesses connect Google with a service-account key (and email with SMTP) instead.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# "Connect with HubSpot" / "Connect with Zoho" (optional: private-app tokens and Zoho Self Clients work without them).
# Redirect URIs: <WEB_BASE_URL>/api/v1/integrations/oauth/hubspot/callback and …/zoho/callback
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# "Continue with Microsoft" for Outlook / Microsoft 365 email (Entra app registration, any account type;
# redirect URI: <WEB_BASE_URL>/api/v1/integrations/oauth/microsoft/callback)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# WhatsApp Business (Cloud API) through one Meta app for the platform. Setup: docs/WHATSAPP_SETUP.md
# Webhook: <PUBLIC_BASE_URL>/api/v1/webhooks/whatsapp. Without META_APP_SECRET the webhook refuses everything.
# META_APP_ID=
# META_APP_SECRET=
# META_EMBEDDED_SIGNUP_CONFIG_ID=
# WHATSAPP_VERIFY_TOKEN=
# META_GRAPH_VERSION=v23.0
# Wait after a customer's last message before the agent answers (several quick messages, one reply)
# WHATSAPP_REPLY_DELAY_MS=2500
# Voice notes: largest download, and longest note the agent transcribes (longer ones get "send a shorter one")
# WHATSAPP_MEDIA_MAX_MB=16
# WHATSAPP_VOICE_MAX_SECONDS=180
# Gemini text-to-speech model for voice replies (default gemini-2.5-flash-preview-tts; follows Google's naming)
# GEMINI_TTS_MODEL=
# Queue dashboard at <API>/admin/queues for platform operators (basic auth, user "admin"; ≥ 16 characters)
# ADMIN_BOARD_PASSWORD=
# Your own rates for cost estimates, JSON in micro-dollars per unit (defaults: public list prices)
# USAGE_PRICES={"TELEPHONY_MINUTES":8500}
# Worker: how often analytics roll-ups are refreshed for tenants with recent calls
ANALYTICS_SWEEP_MINUTES=10
# Development only: let webhooks/SMTP reach localhost and private networks (refused in production)
ALLOW_PRIVATE_NETWORK_TOOLS=false

# ── Docker (docker compose up) ────────────────────────────────────────────────
# Passwords for the containerised Postgres (owner runs migrations; app is the RLS-restricted login)
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Job key prefix (the API and worker must match); give each environment sharing a Redis its own
QUEUE_PREFIX=bull

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=4000
# Proxies allowed to set X-Forwarded-For (the web app proxies /api from localhost in development)
TRUST_PROXY=loopback
CORS_ORIGINS=http://localhost:3000
# Public HTTPS URL of the API as Twilio sees it (e.g. your tunnel URL); must match exactly for signatures
PUBLIC_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
# The platform's own emails (invitations, password resets). Development: Mailpit from
# infra/docker-compose.yml (web UI on http://localhost:8025). Production: smtps://user:pass@host:465
# or smtp://user:pass@host:587 (STARTTLS required). Without it, invitation links are shown to copy.
# SMTP_URL=smtp://localhost:1025
# MAIL_FROM=Voice Agent Platform <no-reply@your-domain.com>
# Secure (HTTPS-only) cookies; defaults to true when NODE_ENV=production
# COOKIE_SECURE=false

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
# Prometheus metrics for the worker (/metrics on this port; keep it off the public internet)
WORKER_METRICS_PORT=9464

# ── Observability ─────────────────────────────────────────────────────────────
# /metrics on the API answers private-network requests; set a token to allow others (Bearer <token>)
# METRICS_TOKEN=
# Send traces to an OpenTelemetry collector (e.g. http://localhost:4318); off when unset
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Grafana admin password for `docker compose --profile observability up`
# GRAFANA_ADMIN_PASSWORD=

# ── Web ───────────────────────────────────────────────────────────────────────
API_INTERNAL_URL=http://localhost:4000

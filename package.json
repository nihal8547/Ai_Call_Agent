{
  "name": "ai-voice-agent-platform",
  "private": true,
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run generate -w @platform/db",
    "db:migrate": "npm run migrate:deploy -w @platform/db",
    "db:migrate:dev": "npm run migrate:dev -w @platform/db --",
    "db:seed": "npm run seed -w @platform/db",
    "db:check": "npm run check -w @platform/db",
    "simulate": "npm run simulate -w @platform/runtime --",
    "audit:prod": "node scripts/audit.mjs",
    "check:live": "node --env-file-if-exists=.env scripts/check-live.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@types/node": "^22.20.4",
    "fastify": "5.12.5",
    "deepmerge-ts": "^8.0.2",
    "uuid": "^11.1.1"
  }
}

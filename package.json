{
  "name": "ai-voice-agent-platform",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @platform/db generate",
    "db:migrate": "pnpm --filter @platform/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @platform/db migrate:dev",
    "db:seed": "pnpm --filter @platform/db seed",
    "db:check": "pnpm --filter @platform/db check",
    "simulate": "pnpm --filter @platform/core simulate --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.7"
  }
}

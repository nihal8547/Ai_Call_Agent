{
  "name": "@platform/rag",
  "version": "0.0.0",
  "private": true,
  "description": "Knowledge pipeline: file detection, text extraction, cleaning, chunking, ingestion and hybrid retrieval",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@platform/ai": "workspace:*",
    "@platform/db": "workspace:*",
    "@platform/storage": "workspace:*",

    "mammoth": "^1.12.0",
    "papaparse": "^5.5.0",
    "unpdf": "^1.8.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.0",
    "docx": "^9.5.0",
    "pdf-lib": "^1.17.1"
  }
}

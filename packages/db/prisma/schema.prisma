// Universal AI Voice Agent Platform — database schema (PostgreSQL + pgvector)
//
// Conventions
// - Every tenant-owned table has `tenantId` and is protected by PostgreSQL
//   Row-Level Security (policies: migrations/*_rls/migration.sql).
// - pgvector HNSW index is hand-written in the init migration (Prisma cannot model it);
//   scripts/check-migrations.sh guards against drift.
// - Tables/columns are snake_case in the database, camelCase in Prisma Client.
// - Business-specific data (qualification fields, workflows, collected answers)
//   lives in JSONB validated by zod schemas in @platform/shared — never as columns.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_MIGRATION_URL")
  extensions = [vector, citext, pgcrypto]
}

// ─────────────────────────────── Enums ───────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AgentVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum TelephonyProvider {
  TWILIO
  TELNYX
  PLIVO
  SIP
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  EXTRACTING
  EMBEDDING
  READY
  FAILED
}

enum IntegrationType {
  GOOGLE_SHEETS
  GOOGLE_CALENDAR
  CALCOM
  HUBSPOT
  ZOHO
  SALESFORCE
  EMAIL_SMTP
  WHATSAPP
  WEBHOOK
  REST_API
}

enum IntegrationStatus {
  CONNECTED
  ERROR
  EXPIRED
  DISCONNECTED
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY
  CANCELED
}

enum CallOutcome {
  LEAD_CAPTURED
  APPOINTMENT_BOOKED
  ENQUIRY_ANSWERED
  HUMAN_HANDOFF
  FOLLOW_UP_REQUIRED
  ABANDONED
  NONE
}

enum QualificationStatus {
  NOT_STARTED
  PARTIAL
  QUALIFIED
  DISQUALIFIED
}

enum CallEventType {
  CALL_STARTED
  USER_TURN
  AGENT_TURN
  EXTRACTION
  VALIDATION_ERROR
  RAG_RETRIEVAL
  TOOL_CALL
  FALLBACK
  GUARD_BLOCKED
  HANDOFF
  CALL_ENDED
}

enum AppointmentStatus {
  UPCOMING
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum FailedJobStatus {
  FAILED
  RETRIED
  DISMISSED
}

enum UsageKind {
  TELEPHONY_MINUTES
  LLM_INPUT_TOKENS
  LLM_OUTPUT_TOKENS
  EMBEDDING_TOKENS
  TTS_CHARACTERS
  STT_SECONDS
  STORAGE_BYTES
  /// Messages the platform sent on WhatsApp (agent and staff)
  WHATSAPP_MESSAGES
  /// Streaming voice minutes (Twilio ConversationRelay)
  VOICE_STREAMING_MINUTES
}

// ─────────────────────── Tenancy, users, access ───────────────────────

model Tenant {
  id             String       @id @default(uuid(7)) @db.Uuid
  name           String       @db.VarChar(120)
  slug           String       @unique @db.Citext
  industry       String?      @db.VarChar(60)
  timezone       String       @default("Asia/Qatar") @db.VarChar(64)
  /// ISO 3166-1 alpha-2; drives the calling code, currency and defaults (IN, QA, AE, …)
  country        String       @default("QA") @db.VarChar(2)
  /// Country calling code for numbers spoken or sent without one ("91", "974")
  callingCode    String       @default("974") @map("calling_code") @db.VarChar(4)
  currency       String       @default("QAR") @db.VarChar(3)
  /// Call transcripts and details older than this are purged nightly (analytics and leads stay)
  retentionDays  Int          @default(365) @map("retention_days")
  /// Calls are ended politely after this long (toll-fraud and runaway-call protection)
  maxCallMinutes Int          @default(20) @map("max_call_minutes")
  status         TenantStatus @default(ACTIVE)
  /// Why the platform suspended (or reactivated) the business, shown to the operator
  statusReason   String?      @map("status_reason")
  statusChangedAt DateTime?   @map("status_changed_at") @db.Timestamptz(3)
  plan           String       @default("free") @db.VarChar(40)
  /// zod: TenantLimits (max calls/day, minutes/month, documents, storage, tokens)
  usageLimits    Json         @default("{}") @map("usage_limits")
  /// Per-tenant data-encryption key, itself encrypted with the platform master key (envelope encryption)
  encryptedDek   Bytes        @map("encrypted_dek")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships          Membership[]
  roles                Role[]
  invitations          Invitation[]
  apiKeys              ApiKey[]
  agents               Agent[]
  agentVersions        AgentVersion[]
  phoneNumbers         PhoneNumber[]
  collections          KnowledgeCollection[]
  documents            Document[]
  chunks               DocumentChunk[]
  integrations         Integration[]
  agentTools           AgentTool[]
  calls                Call[]
  callEvents           CallEvent[]
  leadStatuses         LeadStatus[]
  leads                Lead[]
  appointments         Appointment[]
  usageRecords         UsageRecord[]
  auditLogs            AuditLog[]
  failedJobs           FailedJob[]
  analytics            AnalyticsHourly[]
  sipTrunks            SipTrunk[]
  blockedCallers       BlockedCaller[]
  alerts               TenantAlert[]
  whatsappNumbers      WhatsAppNumber[]
  conversations        Conversation[]
  conversationMessages ConversationMessage[]

  @@map("tenants")
}

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  email              String    @unique @db.Citext
  name               String    @db.VarChar(120)
  passwordHash       String    @map("password_hash")
  isPlatformOwner    Boolean   @default(false) @map("is_platform_owner")
  /// Set when the owner of the address opened the emailed link (or accepted an emailed invitation)
  emailVerifiedAt    DateTime? @map("email_verified_at") @db.Timestamptz(3)
  totpSecretEnc      Bytes?    @map("totp_secret_enc")
  totpEnabledAt      DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  /// SHA-256 hashes of unused one-time recovery codes
  totpRecoveryHashes String[]  @default([]) @map("totp_recovery_hashes")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Rotating refresh tokens (only the SHA-256 hash is stored)
model RefreshToken {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  familyId       String    @map("family_id") @db.Uuid
  /// Tenant the session is signed into (restored on refresh); membership is re-checked on every request
  activeTenantId String?   @map("active_tenant_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent      String?   @map("user_agent")
  ip             String?   @db.Inet
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Roles are per tenant. System roles (OWNER, ADMIN, MANAGER, STAFF) are seeded on tenant creation.
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String   @db.VarChar(40)
  name        String   @db.VarChar(80)
  /// Permission strings, e.g. "agents:write", "calls:read_transcript" (catalogue in @platform/shared)
  permissions String[]
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invitations Invitation[]

  @@unique([tenantId, key])
  @@map("roles")
}

model Membership {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  assignedLeads         Lead[]                @relation("LeadAssignee")
  assignedConversations Conversation[]        @relation("ConversationAssignee")
  sentMessages          ConversationMessage[] @relation("MessageSentBy")

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  email      String    @db.Citext
  roleId     String    @map("role_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@map("invitations")
}

model ApiKey {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String    @db.VarChar(80)
  prefix     String    @db.VarChar(12)
  keyHash    String    @unique @map("key_hash")
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

// ──────────────────────────── Agents ────────────────────────────

model Agent {
  id                 String      @id @default(uuid(7)) @db.Uuid
  tenantId           String      @map("tenant_id") @db.Uuid
  name               String      @db.VarChar(80)
  description        String?     @db.VarChar(500)
  status             AgentStatus @default(INACTIVE)
  templateKey        String?     @map("template_key") @db.VarChar(60)
  /// Version that live calls use; null until first publish
  publishedVersionId String?     @unique @map("published_version_id") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  publishedVersion AgentVersion?     @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions         AgentVersion[]    @relation("AgentVersions")
  phoneNumbers     PhoneNumber[]
  collections      AgentCollection[]
  documentLinks    DocumentAgent[]
  tools            AgentTool[]
  calls            Call[]
  leads            Lead[]
  appointments     Appointment[]
  analytics        AnalyticsHourly[]
  whatsappNumbers  WhatsAppNumber[]
  conversations    Conversation[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("agents")
}

model AgentVersion {
  id          String             @id @default(uuid(7)) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  agentId     String             @map("agent_id") @db.Uuid
  version     Int
  status      AgentVersionStatus @default(DRAFT)
  /// zod: AgentConfig (greeting, persona, instructions, qualificationFields, workflow, knowledge,
  /// tools, escalation, handoff, workingHours, appointment, llm, limits)
  config      Json
  configHash  String             @map("config_hash") @db.VarChar(64)
  changeNote  String?            @map("change_note") @db.VarChar(500)
  createdById String?            @map("created_by_id") @db.Uuid
  publishedAt DateTime?          @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent       Agent  @relation("AgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  publishedOf Agent? @relation("PublishedVersion")
  calls       Call[]

  @@unique([agentId, version])
  @@index([tenantId])
  @@map("agent_versions")
}

model PhoneNumber {
  id                    String            @id @default(uuid(7)) @db.Uuid
  tenantId              String            @map("tenant_id") @db.Uuid
  agentId               String?           @map("agent_id") @db.Uuid
  e164                  String            @unique @db.VarChar(20)
  provider              TelephonyProvider @default(TWILIO)
  providerSid           String?           @map("provider_sid") @db.VarChar(64)
  friendlyName          String?           @map("friendly_name") @db.VarChar(80)
  isActive              Boolean           @default(true) @map("is_active")
  /// TWILIO numbers: the business's existing number (Ooredoo, Vodafone, …) that forwards to this one
  forwardedFrom         String?           @unique @map("forwarded_from") @db.VarChar(20)
  /// ooredoo | vodafone_qa | other (drives the setup instructions)
  carrier               String?           @db.VarChar(30)
  /// NO_ANSWER_BUSY_UNREACHABLE (staff first) | ALL
  forwardingMode        String?           @map("forwarding_mode") @db.VarChar(40)
  /// NONE | PENDING | VERIFIED | FAILED: a test call proved forwarding reaches the agent
  verificationStatus    String            @default("NONE") @map("verification_status") @db.VarChar(10)
  verificationExpiresAt DateTime?         @map("verification_expires_at") @db.Timestamptz(3)
  verifiedAt            DateTime?         @map("verified_at") @db.Timestamptz(3)
  /// What the carrier passed on the test call: { from, forwardedFrom, callerIdKept }
  verification          Json              @default("{}")
  /// SIP numbers: the trunk they arrive on
  sipTrunkId            String?           @map("sip_trunk_id") @db.Uuid
  /// Simultaneous calls allowed on this number (null = no limit)
  maxConcurrentCalls    Int?              @map("max_concurrent_calls")
  lastCallAt            DateTime?         @map("last_call_at") @db.Timestamptz(3)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent    Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  sipTrunk SipTrunk? @relation(fields: [sipTrunkId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([sipTrunkId])
  @@map("phone_numbers")
}

// ─────────────────────── Knowledge & documents (RAG) ───────────────────────

model KnowledgeCollection {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  /// zod: CollectionSettings (chunkSize, chunkOverlap, defaultTopK, minScore)
  settings    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents Document[]
  chunks    DocumentChunk[]
  agents    AgentCollection[]

  @@unique([tenantId, name])
  @@map("knowledge_collections")
}

model AgentCollection {
  tenantId     String @map("tenant_id") @db.Uuid
  agentId      String @map("agent_id") @db.Uuid
  collectionId String @map("collection_id") @db.Uuid

  agent      Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  collection KnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([agentId, collectionId])
  @@index([tenantId])
  @@map("agent_collections")
}

model Document {
  id            String         @id @default(uuid(7)) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  collectionId  String         @map("collection_id") @db.Uuid
  title         String         @db.VarChar(200)
  fileName      String         @map("file_name") @db.VarChar(255)
  mimeType      String         @map("mime_type") @db.VarChar(120)
  sizeBytes     BigInt         @map("size_bytes")
  storageKey    String         @map("storage_key")
  checksum      String         @db.VarChar(64)
  status        DocumentStatus @default(UPLOADING)
  statusMessage String?        @map("status_message")
  progress      Int            @default(0)
  enabled       Boolean        @default(true)
  version       Int            @default(1)
  /// Previous document this one replaced (kept until the new version is READY)
  replacesId    String?        @map("replaces_id") @db.Uuid
  pageCount     Int?           @map("page_count")
  chunkCount    Int            @default(0) @map("chunk_count")
  /// Free-form metadata (tags, language, extracted title/author)
  metadata      Json           @default("{}")
  uploadedById  String?        @map("uploaded_by_id") @db.Uuid
  processedAt   DateTime?      @map("processed_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  collection KnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  chunks     DocumentChunk[]
  agents     DocumentAgent[]

  @@unique([tenantId, collectionId, checksum])
  @@index([tenantId, status])
  @@index([tenantId, collectionId, enabled])
  @@map("documents")
}

/// Optional restriction of a document to specific agents (no rows = visible to all agents of the collection)
model DocumentAgent {
  tenantId   String @map("tenant_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  agentId    String @map("agent_id") @db.Uuid

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  agent    Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([documentId, agentId])
  @@index([tenantId])
  @@map("document_agents")
}

model DocumentChunk {
  id             String                      @id @default(uuid(7)) @db.Uuid
  tenantId       String                      @map("tenant_id") @db.Uuid
  collectionId   String                      @map("collection_id") @db.Uuid
  documentId     String                      @map("document_id") @db.Uuid
  ordinal        Int
  content        String
  tokenCount     Int                         @map("token_count")
  /// page, headingPath, sheet, row, etc.
  metadata       Json                        @default("{}")
  /// pgvector column — read/written with $queryRaw (Prisma does not map vector types)
  embedding      Unsupported("vector(768)")?
  embeddingModel String                      @map("embedding_model") @db.VarChar(80)
  /// Full-text search vector for hybrid search (GENERATED ALWAYS column — never written by the app)
  searchVector   Unsupported("tsvector")?    @default(dbgenerated("to_tsvector('simple'::regconfig, content)")) @map("search_vector")
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  collection KnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  document   Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([tenantId, collectionId])
  @@index([searchVector], type: Gin)
  @@map("document_chunks")
}

// ─────────────────────── Integrations & tools ───────────────────────

model Integration {
  id                   String            @id @default(uuid(7)) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  type                 IntegrationType
  name                 String            @db.VarChar(80)
  status               IntegrationStatus @default(CONNECTED)
  /// AES-256-GCM ciphertext of credentials, encrypted with the tenant DEK. Never returned by the API.
  credentialsEncrypted Bytes             @map("credentials_encrypted")
  /// Non-secret settings (calendar id, sheet id, field mapping, base URL)
  config               Json              @default("{}")
  lastError            String?           @map("last_error")
  lastCheckedAt        DateTime?         @map("last_checked_at") @db.Timestamptz(3)
  expiresAt            DateTime?         @map("expires_at") @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentTools      AgentTool[]
  appointments    Appointment[]
  whatsappNumbers WhatsAppNumber[]

  @@unique([tenantId, name])
  @@index([tenantId, type])
  @@map("integrations")
}

/// Permission grant: an agent may execute `toolName` using `integration`
model AgentTool {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  agentId       String   @map("agent_id") @db.Uuid
  toolName      String   @map("tool_name") @db.VarChar(80)
  integrationId String?  @map("integration_id") @db.Uuid
  config        Json     @default("{}")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent       Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolName])
  @@index([tenantId])
  @@map("agent_tools")
}

// ─────────────────────── Calls, leads, appointments ───────────────────────

model Call {
  id                  String              @id @default(uuid(7)) @db.Uuid
  tenantId            String              @map("tenant_id") @db.Uuid
  agentId             String              @map("agent_id") @db.Uuid
  agentVersionId      String              @map("agent_version_id") @db.Uuid
  provider            TelephonyProvider   @default(TWILIO)
  providerCallSid     String              @unique @map("provider_call_sid") @db.VarChar(64)
  direction           CallDirection       @default(INBOUND)
  fromNumber          String              @map("from_number") @db.VarChar(20)
  toNumber            String              @map("to_number") @db.VarChar(20)
  status              CallStatus          @default(RINGING)
  outcome             CallOutcome         @default(NONE)
  qualificationStatus QualificationStatus @default(NOT_STARTED) @map("qualification_status")
  /// Final validated answers, keyed by qualification field key
  collectedData       Json                @default("{}") @map("collected_data")
  summary             String?
  fallbackTurns       Int                 @default(0) @map("fallback_turns")
  totalTurns          Int                 @default(0) @map("total_turns")
  recordingKey        String?             @map("recording_key")
  startedAt           DateTime            @default(now()) @map("started_at") @db.Timestamptz(3)
  answeredAt          DateTime?           @map("answered_at") @db.Timestamptz(3)
  endedAt             DateTime?           @map("ended_at") @db.Timestamptz(3)
  durationSec         Int?                @map("duration_sec")
  costMicros          BigInt              @default(0) @map("cost_micros")
  /// Live call state, mirrored on every turn so a call survives losing Redis; cleared when the call ends
  sessionSnapshot     Json?               @map("session_snapshot")
  /// How the call reached us: TWILIO (dialled a Twilio number), FORWARDED (from the business's own line), SIP
  connection          String              @default("TWILIO") @db.VarChar(10)
  /// The business number that forwarded the call, when the carrier passed it
  forwardedFrom       String?             @map("forwarded_from") @db.VarChar(20)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentVersion AgentVersion  @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  events       CallEvent[]
  leads        Lead[]
  appointments Appointment[]
  usage        UsageRecord[]

  @@index([tenantId, startedAt(sort: Desc)])
  @@index([tenantId, agentId, startedAt(sort: Desc)])
  @@index([tenantId, outcome])
  @@map("calls")
}

/// Conversation timeline: turns, extractions, RAG retrievals, tool calls, fallbacks, guards
model CallEvent {
  id        String        @id @default(uuid(7)) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  callId    String        @map("call_id") @db.Uuid
  seq       Int
  type      CallEventType
  /// zod: CallEventPayload discriminated union by `type` (PII-redacted before insert)
  payload   Json
  latencyMs Int?          @map("latency_ms")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, seq])
  @@index([tenantId, type, createdAt])
  @@map("call_events")
}

/// Tenant-configurable lead pipeline stages
model LeadStatus {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  key        String   @db.VarChar(40)
  label      String   @db.VarChar(80)
  color      String   @default("#64748b") @db.VarChar(9)
  sortOrder  Int      @default(0) @map("sort_order")
  isDefault  Boolean  @default(false) @map("is_default")
  isTerminal Boolean  @default(false) @map("is_terminal")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenantId, key])
  @@map("lead_statuses")
}

model Lead {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  agentId      String?   @map("agent_id") @db.Uuid
  callId       String?   @map("call_id") @db.Uuid
  statusId     String    @map("status_id") @db.Uuid
  assigneeId   String?   @map("assignee_id") @db.Uuid
  customerName String?   @map("customer_name") @db.VarChar(160)
  phone        String?   @db.VarChar(20)
  email        String?   @db.Citext
  source       String    @default("inbound_call") @db.VarChar(40)
  /// Validated answers keyed by the agent's qualification field keys
  data         Json      @default("{}")
  notes        String?
  followUpAt   DateTime? @map("follow_up_at") @db.Timestamptz(3)
  syncedToCrm  Boolean   @default(false) @map("synced_to_crm")
  /// Per CRM integration id: { status: pending|synced|failed, externalId, syncedAt, error }
  crmSync      Json      @default("{}") @map("crm_sync")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent         Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  call          Call?          @relation(fields: [callId], references: [id], onDelete: SetNull)
  status        LeadStatus     @relation(fields: [statusId], references: [id], onDelete: Restrict)
  assignee      Membership?    @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  appointments  Appointment[]
  conversations Conversation[]

  @@index([tenantId, statusId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, phone])
  @@map("leads")
}

model Appointment {
  id                String            @id @default(uuid(7)) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  agentId           String?           @map("agent_id") @db.Uuid
  leadId            String?           @map("lead_id") @db.Uuid
  callId            String?           @map("call_id") @db.Uuid
  /// Booked in a WhatsApp conversation (instead of a call)
  conversationId    String?           @map("conversation_id") @db.Uuid
  title             String            @db.VarChar(200)
  startsAt          DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime          @map("ends_at") @db.Timestamptz(3)
  timezone          String            @db.VarChar(64)
  status            AppointmentStatus @default(UPCOMING)
  externalRef       String?           @map("external_ref") @db.VarChar(200)
  /// Calendar integration holding the external event (for reschedule/cancel sync)
  integrationId     String?           @map("integration_id") @db.Uuid
  rescheduledFromId String?           @map("rescheduled_from_id") @db.Uuid
  notes             String?
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  call         Call?         @relation(fields: [callId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  integration  Integration?  @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([tenantId, startsAt])
  @@index([tenantId, status])
  @@index([conversationId])
  @@map("appointments")
}

// ─────────────────────── Usage, billing, audit ───────────────────────

model UsageRecord {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  callId     String?   @map("call_id") @db.Uuid
  kind       UsageKind
  quantity   BigInt
  costMicros BigInt    @default(0) @map("cost_micros")
  provider   String?   @db.VarChar(40)
  model      String?   @db.VarChar(80)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  call   Call?  @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([tenantId, kind, createdAt])
  @@map("usage_records")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorType  String   @map("actor_type") @db.VarChar(20) // user | api_key | system
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80) // e.g. agent.published, integration.connected
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?  @db.Inet
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

// ─────────────────────── Background jobs, analytics ───────────────────────

/// Background jobs that used up their retries: the dead-letter list staff can retry or dismiss
model FailedJob {
  id            String          @id @default(uuid(7)) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  queue         String          @db.VarChar(40)
  name          String          @db.VarChar(80)
  jobId         String          @map("job_id") @db.VarChar(200)
  /// What the job was doing, for people ("Call a webhook via CRM webhook")
  label         String          @db.VarChar(200)
  /// zod: the queue's job payload; replayed as is on retry
  payload       Json
  error         String
  attempts      Int
  callId        String?         @map("call_id") @db.Uuid
  leadId        String?         @map("lead_id") @db.Uuid
  integrationId String?         @map("integration_id") @db.Uuid
  status        FailedJobStatus @default(FAILED)
  resolvedAt    DateTime?       @map("resolved_at") @db.Timestamptz(3)
  resolvedBy    String?         @map("resolved_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([queue, jobId])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("failed_jobs")
}

/// Hourly roll-up per agent, bucketed by the local hour (business time zone) each call started in.
/// Derived data: rebuilt from calls, call_events and usage_records at any time.
model AnalyticsHourly {
  tenantId          String   @map("tenant_id") @db.Uuid
  agentId           String   @map("agent_id") @db.Uuid
  /// Local wall-clock hour in the tenant's time zone
  hour              DateTime @db.Timestamp(0)
  calls             Int      @default(0)
  answered          Int      @default(0)
  completed         Int      @default(0)
  failed            Int      @default(0)
  qualified         Int      @default(0)
  disqualified      Int      @default(0)
  leadCaptured      Int      @default(0) @map("lead_captured")
  booked            Int      @default(0)
  enquiryAnswered   Int      @default(0) @map("enquiry_answered")
  handoff           Int      @default(0)
  followUp          Int      @default(0) @map("follow_up")
  abandoned         Int      @default(0)
  durationSec       Int      @default(0) @map("duration_sec")
  turns             Int      @default(0)
  fallbackTurns     Int      @default(0) @map("fallback_turns")
  transfersMissed   Int      @default(0) @map("transfers_missed")
  questions         Int      @default(0)
  questionsAnswered Int      @default(0) @map("questions_answered")
  toolRuns          Int      @default(0) @map("tool_runs")
  toolFailures      Int      @default(0) @map("tool_failures")
  costMicros        BigInt   @default(0) @map("cost_micros")
  /// { fieldKey: calls that collected it } for the qualification funnel
  fields            Json     @default("{}")
  /// { tool: { runs, failed } }
  tools             Json     @default("{}")
  /// { hop: counts per latency bucket } (bucket bounds in @platform/shared analytics)
  latency           Json     @default("{}")
  /// { reason: count } for questions answered with the safe reply
  ragReasons        Json     @default("{}") @map("rag_reasons")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([tenantId, agentId, hour])
  @@index([tenantId, hour])
  @@map("analytics_hourly")
}

// ─────────────────────── Existing numbers over SIP, abuse controls ───────────────────────

/**
 * A SIP connection from the business's carrier or PBX (Ooredoo SIP-T, Vodafone business SIP, a
 * PBX/SBC) to a platform SIP domain. Calls to its numbers (phone_numbers.sip_trunk_id) reach the agents.
 */
model SipTrunk {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  name              String    @db.VarChar(80)
  /// ooredoo | vodafone_qa | pbx | other
  carrier           String    @db.VarChar(30)
  /// Platform-unique label; the full SIP domain is <domainName>.sip.twilio.com
  domainName        String    @unique @map("domain_name") @db.VarChar(63)
  /// Source addresses allowed to send calls (IPv4 CIDRs); checked by the SIP domain
  allowedIps        String[]  @default([]) @map("allowed_ips")
  authUsername      String?   @map("auth_username") @db.VarChar(40)
  /// Sealed with the tenant key; the password is shown once when generated
  authSecretEnc     Bytes?    @map("auth_secret_enc")
  twilioDomainSid   String?   @map("twilio_domain_sid") @db.VarChar(40)
  twilioIpAclSid    String?   @map("twilio_ip_acl_sid") @db.VarChar(40)
  twilioCredListSid String?   @map("twilio_cred_list_sid") @db.VarChar(40)
  /// PENDING_SETUP (platform must create the domain) | ACTIVE | ERROR | DISABLED
  status            String    @default("PENDING_SETUP") @db.VarChar(16)
  lastError         String?   @map("last_error")
  lastCallAt        DateTime? @map("last_call_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  numbers PhoneNumber[]

  @@unique([tenantId, name])
  @@map("sip_trunks")
}

/**
 * Callers a business never wants the agent to answer (spam, abuse, toll fraud)
 */
model BlockedCaller {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// E.164, or a prefix ending in * (e.g. +882*) to block whole ranges
  pattern   String   @db.VarChar(21)
  reason    String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, pattern])
  @@map("blocked_callers")
}

/**
 * Things the business owner should know about: limits reached, unusual call volume, a silent SIP trunk
 */
model TenantAlert {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  /// usage_limit | call_spike | sip_trunk_silent | …
  kind           String    @db.VarChar(40)
  /// Same key → one open alert, not a new one each time
  dedupeKey      String    @map("dedupe_key") @db.VarChar(120)
  message        String    @db.VarChar(500)
  data           Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, acknowledgedAt])
  @@map("tenant_alerts")
}

// ─────────────────────── WhatsApp ───────────────────────

enum WhatsAppNumberStatus {
  /// Receiving and sending
  CONNECTED
  /// Saved, but Meta registration didn't finish (see last_error)
  PENDING
  /// Disconnected by the business; kept so its conversations keep their history
  DISCONNECTED
}

enum ConversationMode {
  /// The agent answers
  AI
  /// A staff member took over; the agent stays quiet
  HUMAN
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  /// Shown in the Inbox only (e.g. "Sara took over"); never sent
  INTERNAL
}

enum MessageSender {
  CUSTOMER
  AI
  STAFF
  SYSTEM
}

enum ConversationMessageType {
  TEXT
  AUDIO
  IMAGE
  DOCUMENT
  VIDEO
  STICKER
  LOCATION
  CONTACTS
  INTERACTIVE
  REACTION
  TEMPLATE
  NOTE
  UNSUPPORTED
}

enum ConversationMessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

/// A business's WhatsApp number on the Cloud API. Webhooks are routed by phone_number_id.
model WhatsAppNumber {
  id            String               @id @default(uuid(7)) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  /// The sealed business token lives on this WHATSAPP integration
  integrationId String?              @map("integration_id") @db.Uuid
  wabaId        String               @map("waba_id") @db.VarChar(64)
  phoneNumberId String               @unique @map("phone_number_id") @db.VarChar(64)
  displayNumber String               @map("display_number") @db.VarChar(32)
  verifiedName  String?              @map("verified_name") @db.VarChar(160)
  agentId       String?              @map("agent_id") @db.Uuid
  status        WhatsAppNumberStatus @default(CONNECTED)
  qualityRating String?              @map("quality_rating") @db.VarChar(20)
  lastError     String?              @map("last_error")
  /// zod: WhatsAppNumberSettings (reply mode, voice, greeting …)
  settings      Json                 @default("{}")
  /// The number stays on the WhatsApp Business app too (coexistence): never registered by us
  onBusinessApp Boolean              @default(false) @map("on_business_app")
  /// Meta's messaging limit (e.g. TIER_1K), from checks and quality webhooks
  messagingLimit String?             @map("messaging_limit") @db.VarChar(32)
  /// Last webhook Meta sent about this number (proves webhooks arrive)
  lastWebhookAt DateTime?            @map("last_webhook_at") @db.Timestamptz(3)
  /// Result of the last connection check (registration, webhook subscription, name status …)
  health        Json                 @default("{}")
  connectedAt   DateTime             @default(now()) @map("connected_at") @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration   Integration?   @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  agent         Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  conversations Conversation[]

  @@index([tenantId])
  @@map("whatsapp_numbers")
}

/// One customer's chat with one WhatsApp number (a new one starts after it is closed)
model Conversation {
  id                 String           @id @default(uuid(7)) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  whatsappNumberId   String           @map("whatsapp_number_id") @db.Uuid
  agentId            String?          @map("agent_id") @db.Uuid
  /// The published version answering this conversation (pinned like a call)
  agentVersionId     String?          @map("agent_version_id") @db.Uuid
  /// The customer's WhatsApp id (digits, no "+")
  contactWaId        String           @map("contact_wa_id") @db.VarChar(32)
  contactPhone       String           @map("contact_phone") @db.VarChar(20)
  contactName        String?          @map("contact_name") @db.VarChar(160)
  mode               ConversationMode @default(AI)
  /// The agent runtime's saved state between messages
  engineSession      Json?            @map("engine_session")
  /// Start of the 24-hour window for free-form replies
  lastInboundAt      DateTime?        @map("last_inbound_at") @db.Timestamptz(3)
  lastMessageAt      DateTime         @default(now()) @map("last_message_at") @db.Timestamptz(3)
  lastMessagePreview String?          @map("last_message_preview") @db.VarChar(200)
  unreadCount        Int              @default(0) @map("unread_count")
  assigneeId         String?          @map("assignee_id") @db.Uuid
  leadId             String?          @map("lead_id") @db.Uuid
  closedAt           DateTime?        @map("closed_at") @db.Timestamptz(3)
  /// The agent has answered every customer message up to this time
  agentHandledAt     DateTime?        @map("agent_handled_at") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappNumber WhatsAppNumber        @relation(fields: [whatsappNumberId], references: [id], onDelete: Cascade)
  agent          Agent?                @relation(fields: [agentId], references: [id], onDelete: SetNull)
  assignee       Membership?           @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  lead           Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages       ConversationMessage[]
  appointments   Appointment[]

  @@unique([id, tenantId])
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@index([tenantId, mode])
  @@index([whatsappNumberId, contactWaId])
  @@map("conversations")
}

model ConversationMessage {
  id                 String                    @id @default(uuid(7)) @db.Uuid
  tenantId           String                    @map("tenant_id") @db.Uuid
  conversationId     String                    @map("conversation_id") @db.Uuid
  /// Meta's message id; unique, so webhook retries are stored once
  wamid              String?                   @unique @db.VarChar(128)
  direction          MessageDirection
  sender             MessageSender
  sentById           String?                   @map("sent_by_id") @db.Uuid
  type               ConversationMessageType   @default(TEXT)
  text               String?
  /// Meta's media id (received files); downloaded into object storage as media_key
  mediaId            String?                   @map("media_id") @db.VarChar(64)
  mediaKey           String?                   @map("media_key") @db.VarChar(255)
  mediaMime          String?                   @map("media_mime") @db.VarChar(100)
  mediaFilename      String?                   @map("media_filename") @db.VarChar(255)
  mediaBytes         Int?                      @map("media_bytes")
  mediaSeconds       Int?                      @map("media_seconds")
  transcript         String?
  transcriptLanguage String?                   @map("transcript_language") @db.VarChar(10)
  status             ConversationMessageStatus
  errorCode          Int?                      @map("error_code")
  errorTitle         String?                   @map("error_title") @db.VarChar(300)
  replyToWamid       String?                   @map("reply_to_wamid") @db.VarChar(128)
  /// Staff-only details: knowledge sources, tools, latency
  meta               Json                      @default("{}")
  sentAt             DateTime?                 @map("sent_at") @db.Timestamptz(3)
  deliveredAt        DateTime?                 @map("delivered_at") @db.Timestamptz(3)
  readAt             DateTime?                 @map("read_at") @db.Timestamptz(3)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Composite key: a message can only point at a conversation of its own business
  conversation Conversation @relation(fields: [conversationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  sentBy       Membership?  @relation("MessageSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
  @@map("conversation_messages")
}

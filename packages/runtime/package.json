{
  "name": "@platform/runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Per-turn orchestration (LangGraph): LLM understanding, knowledge retrieval, core engine, phrasing, guard",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "simulate": "tsx --env-file-if-exists=../../.env scripts/simulate.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.1.0",
    "@langchain/langgraph": "^1.4.0",
    "@platform/ai": "workspace:*",
    "@platform/core": "workspace:*",
    "@platform/shared": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@platform/templates": "workspace:*",
    "tsx": "^4.23.15"
  }
}
